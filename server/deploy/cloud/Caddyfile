{
	email {$CADDY_ADMIN_EMAIL}
	order reverse_proxy first
}

hanbaodoudou.com {
	encode zstd gzip
	root * /srv/www/hanbaodoudou.com

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# Keep documents fresh, while allowing stable assets to stay warm in browsers.
	# `route` preserves the override order: default -> static -> versioned.
	route {
		header Cache-Control "no-cache, max-age=0, must-revalidate"

		@staticAssets {
			path *.css *.js *.avif *.webp *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.otf *.eot *.mp3 *.m4a *.aac *.ogg *.opus *.wav *.flac *.mp4 *.webm
			file
			not query v=*
		}
		header @staticAssets Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"

		@versionedAssets {
			path *.css *.js *.avif *.webp *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.otf *.eot *.mp3 *.m4a *.aac *.ogg *.opus *.wav *.flac *.mp4 *.webm
			file
			query v=*
		}
		header @versionedAssets Cache-Control "public, max-age=31536000, immutable"

		file_server
	}
}

www.hanbaodoudou.com {
	redir https://hanbaodoudou.com{uri} permanent
}

api.hanbaodoudou.com {
	encode zstd gzip

	log {
		output file /var/log/caddy/api-access.log {
			roll_size 10MiB
			roll_keep 14
			roll_keep_for 240h
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy 172.17.0.1:8080 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Port {server_port}
	}
}
